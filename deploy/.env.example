# Variables del servidor (docker-compose.yml de esta carpeta). Plantilla SIN valores reales:
# copiarla como .env en el servidor (está en el .gitignore) y rellenarla allí.
# Para generar claves:  openssl rand -hex 32

# --- n8n (parte A) ---
N8N_DB_PASSWORD=
# Si se pierde o cambia, n8n no puede leer las credenciales guardadas: guardar copia aparte
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=https://n8n.theblacklotustcg.onl/
N8N_PORT=5678
# true con HTTPS; false solo para probar en local por http
N8N_SECURE_COOKIE=true

# --- Back-office (parte B) ---
BO_DB_PASSWORD=
BO_DB_ROOT_PASSWORD=
# La que manda n8n en X-Api-Key (credencial "Back-office X-Api-Key")
BO_API_KEY=
BO_PORT=8080
