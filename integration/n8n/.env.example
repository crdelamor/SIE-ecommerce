# Variables de n8n para el servidor de la nube (parte A). Plantilla SIN valores reales:
# copiarla como .env junto al docker-compose (el .env está en el .gitignore) y rellenarla allí.

# Base de datos persistente: PostgreSQL (n8n ya no admite MySQL). Sin ella se pierden
# los flujos, las credenciales y el historial de ejecuciones al reiniciar.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=

# Cifra las credenciales guardadas en la base de datos. Fija y con copia de seguridad:
# si cambia o se pierde, n8n no puede leer las credenciales.
N8N_ENCRYPTION_KEY=

# URL pública: n8n la usa para construir las URLs de los webhooks (la de la tienda y la de Telegram)
N8N_HOST=n8n.theblacklotustcg.onl
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.theblacklotustcg.onl/

GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
