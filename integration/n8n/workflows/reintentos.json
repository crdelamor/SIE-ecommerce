    {
      "id": "4a1b2c30-0002-4b00-8000-000000000002",
      "name": "Ajustes",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "URLs de la API de la tienda, del back-office y del webhook del flujo Pedidos. Cambiarlas aquí al desplegar.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "tienda_api_url",
              "value": "http://localhost:8000",
              "type": "string"
            },
            {
              "id": "a2",
